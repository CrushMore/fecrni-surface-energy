# usage: lmp -in slab_NVT.in -var name NAME -var T 300 -var seed 11
units           metal
atom_style      atomic
boundary        p p p
read_data       ../data/${name}.data
pair_style      eam/alloy
pair_coeff      * * ../potentials/FeNiCr_Bonny_2013_ptDef.eam.alloy Fe Cr Ni
neighbor        2.0 bin
timestep        0.002

minimize        1e-10 1e-10 5000 50000
velocity        all create ${T} ${seed} dist gaussian
fix             nvt all nvt temp ${T} ${T} 0.2
thermo          5000
run             50000

variable        pe equal pe
fix             avg all ave/time 10 1 10 v_pe ave running
run             250000
print           "RESULT_SLAB_T ${name} T ${T} N $(atoms) E $(f_avg) Lx $(lx) Ly $(ly)"