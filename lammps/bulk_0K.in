# usage: lmp -in bulk_0K.in -var seed 11 -var N 256 -var nrep 4
units           metal
atom_style      atomic
boundary        p p p
read_data       ../data/bulk_N${N}_seed${seed}.data

pair_style      eam/alloy
pair_coeff      * * ../potentials/FeNiCr_Bonny_2013_ptDef.eam.alloy Fe Cr Ni

neighbor        2.0 bin
thermo_style    custom step pe press lx ly lz
thermo          100

# 1) relax atoms only, then 2) relax box + atoms, then 3) final atoms-only polish
minimize        1e-12 1e-12 10000 100000
fix             rlx all box/relax aniso 0.0 vmax 0.001
minimize        1e-14 1e-14 20000 200000
unfix           rlx
minimize        1e-14 1e-14 20000 200000

variable        epa equal pe/atoms
variable        a_x equal lx/${nrep}
variable        a_y equal ly/${nrep}
variable        a_z equal lz/${nrep}
print           "RESULT seed ${seed} E_per_atom ${epa} eV a_x ${a_x} a_y ${a_y} a_z ${a_z} P $(press) bar"
