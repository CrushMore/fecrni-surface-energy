# usage: lmp -in slab_0K.in -var name slab_111_4x4x8_g20_s11 -var Ebulk -4.1201
units           metal
atom_style      atomic
boundary        p p p
read_data       ../data/${name}.data

pair_style      eam/alloy
pair_coeff      * * ../potentials/FeNiCr_Bonny_2013_ptDef.eam.alloy Fe Cr Ni

neighbor        2.0 bin
thermo_style    custom step pe lx ly lz
thermo          100

minimize        1e-12 1e-12 10000 100000
minimize        1e-14 1e-14 20000 200000

variable        gamma equal (pe-atoms*${Ebulk})/(2*lx*ly)*16.0217663
print           "RESULT_SLAB ${name} N $(atoms) E $(pe) gamma_J_m2 ${gamma}"